{
  "id": "ecommerce-product-extraction",
  "class": "schema",
  "domain": "e-commerce",
  "source": "contributed:modelrig-core (A2 domain diversification)",
  "prompt": "Extract the product listing below into the required JSON structure. Prices are numbers without currency symbols; dimensions are in centimeters.\n\nPRODUCT LISTING (synthetic):\nAurora Trail 2 Ultralight Backpacking Tent — SKU AT2-2026-GRN, color Moss Green. Sale price $289.95 (regular $349.95). Sleeps 2. Packed weight 1.34 kg. Floor dimensions 213 x 127 cm, peak height 102 cm. Materials: 15D ripstop nylon fly, 7001-series aluminum poles. In stock: 47 units. Ships in 2 business days. Average rating 4.6 from 312 reviews. Not seam-sealed for extreme winter use.",
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "sku",
      "name",
      "color",
      "pricing",
      "capacity_persons",
      "packed_weight_kg",
      "dimensions_cm",
      "inventory",
      "rating"
    ],
    "properties": {
      "sku": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "color": {
        "type": "string"
      },
      "pricing": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sale_price",
          "regular_price",
          "currency"
        ],
        "properties": {
          "sale_price": {
            "type": "number"
          },
          "regular_price": {
            "type": "number"
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD"
            ]
          }
        }
      },
      "capacity_persons": {
        "type": "integer"
      },
      "packed_weight_kg": {
        "type": "number"
      },
      "dimensions_cm": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "floor_length",
          "floor_width",
          "peak_height"
        ],
        "properties": {
          "floor_length": {
            "type": "number"
          },
          "floor_width": {
            "type": "number"
          },
          "peak_height": {
            "type": "number"
          }
        }
      },
      "inventory": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "in_stock_units",
          "ships_in_business_days"
        ],
        "properties": {
          "in_stock_units": {
            "type": "integer"
          },
          "ships_in_business_days": {
            "type": "integer"
          }
        }
      },
      "rating": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "average",
          "review_count"
        ],
        "properties": {
          "average": {
            "type": "number"
          },
          "review_count": {
            "type": "integer"
          }
        }
      }
    }
  },
  "expectedValues": {
    "sku": "AT2-2026-GRN",
    "pricing.sale_price": 289.95,
    "pricing.regular_price": 349.95,
    "capacity_persons": 2,
    "packed_weight_kg": 1.34,
    "dimensions_cm.floor_width": 127,
    "inventory.in_stock_units": 47,
    "rating.review_count": 312
  },
  "subtype": "extraction.tabular"
}
